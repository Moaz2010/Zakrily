# Supabase Postgres connection string — use the Session Pooler URI from
# Project Settings > Database > Connection string > SQLAlchemy/psycopg2
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Local development without Supabase: DATABASE_URL=sqlite:///./zakrely.db
# SQLite supports account/progress/quiz flows; vector search still requires Postgres.

# Supabase project (for Storage — math submission photos)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=math-uploads

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (chat + Whisper STT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Shared lesson chat + Speech-to-Text (Whisper)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

# Text-to-speech (Gemini TTS)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Aoede

# Default lesson-chat provider: anthropic | openai | groq
CHAT_PROVIDER=anthropic

ENVIRONMENT=development
